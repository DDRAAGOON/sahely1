<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules.

  Session tokens and KYC state must never leave the device through cloud backup
  or device-to-device transfer, so both channels are opted out entirely. This
  pairs with android:allowBackup="false" for older releases.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
